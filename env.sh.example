# Copy to env.sh and edit:   cp env.sh.example env.sh
# Loaded by start.sh. Points AI in the Box and the AIDB Showcase at your Postgres.
# The database needs the AIDB extension (CREATE EXTENSION aidb CASCADE;).
export PGHOST=localhost PGPORT=5432 PGDATABASE=postgres PGUSER=postgres
# export PGPASSWORD=...   # only if the server asks for one, or use ~/.pgpass

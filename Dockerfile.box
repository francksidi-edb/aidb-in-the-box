# AI in the Box, all in one container: EDB Postgres + AIDB (from the aibox-db image) + the app, the AIDB Introspector and JupyterLab.
# Build with ./docker-box.sh (it builds the aibox-db base first, using your EDB token as a build secret).
ARG BASE=aibox-db:18
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-pip git \
 && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/aibox/venv \
 && /opt/aibox/venv/bin/pip install --no-cache-dir flask jupyterlab jupysql sqlalchemy psycopg2-binary pandas datasets
WORKDIR /opt/aibox/app
RUN git clone --depth 1 https://github.com/francksidi-edb/aidb-showcase.git aidb-showcase && rm -rf aidb-showcase/.git
COPY box_server.py introspect_mount.py ./
COPY introspector introspector
COPY static static
COPY notebooks notebooks
COPY edb/box-entrypoint.sh /opt/aibox/box-entrypoint.sh
RUN chmod +x /opt/aibox/box-entrypoint.sh
ENV AIBOX_HOST=0.0.0.0 AIBOX_PORT=8650 AIBOX_JUPYTER_PORT=8888 AIBOX_NO_BROWSER=1 AIBOX_JUPYTER_AUTOSTART=1 \
    PATH=/opt/aibox/venv/bin:$PATH
EXPOSE 8650 8888 5444
ENTRYPOINT ["/opt/aibox/box-entrypoint.sh"]

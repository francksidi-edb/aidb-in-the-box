# Copy to .env and edit:   cp .env.example .env
# Read by ./start.sh and the app. Every value here reaches the app AND every notebook (JupyterLab inherits it),
# so the notebooks connect with exactly these settings. .env wins over env.sh. Restart the app (and JupyterLab)
# after a change. Quote values that contain spaces or characters like $ & # !
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=""

# Optional: anything else the notebooks read from the environment, for example a model key.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
